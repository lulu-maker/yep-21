<odoo>
    <record id="view_project_form_inherit_contractor_job_orders" model="ir.ui.view">
        <field name="name">project.project.form.contractor.job.orders</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <xpath expr="//div[contains(@class, 'oe_button_box')]" position="inside">
                <button name="action_view_job_orders" type="object" class="oe_stat_button" icon="fa-briefcase" string="Job Orders">
                    <field name="job_order_count" widget="statinfo" string="Job Orders"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
