<odoo>
    <record id="purchase_order_form_inherit_contractor_job_orders" model="ir.ui.view">
        <field name="name">purchase.order.form.contractor.job.orders</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_generate_job_orders" type="object" string="Generate Job Orders" class="oe_highlight"/>
                <button name="action_view_job_orders" type="object" string="Job Orders" class="oe_stat_button" icon="fa-briefcase">
                    <field name="job_order_count" widget="statinfo" string="Job Orders"/>
                </button>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Contractor Lines">
                    <field name="contractor_line_ids">
                        <tree editable="bottom">
                            <field name="contractor_id"/>
                            <field name="project_id"/>
                            <field name="position_title"/>
                            <field name="role_scope"/>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="consultancy_fee"/>
                            <field name="salary_package"/>
                            <field name="per_diem"/>
                            <field name="mobile_allowance"/>
                            <field name="transport_reimbursement"/>
                            <field name="accommodation"/>
                            <field name="car_rental"/>
                            <field name="total_amount" readonly="1"/>
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
